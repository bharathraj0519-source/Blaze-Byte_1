# ==============================================================================
# BLAZEBYTE STUDIO — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and configure your production environment variables
# ==============================================================================

PORT=3000
NODE_ENV=production

# Supabase Server-Side Configuration (Keep secret on server)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# Administrative Notification & Data Protection Officer Contact
ADMIN_NOTIFICATION_EMAIL=your-agency-email@domain.com
DPO_EMAIL=your-agency-email@domain.com

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://www.blazebyte.shop,https://blazebyte.shop
